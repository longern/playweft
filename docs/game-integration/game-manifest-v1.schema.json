{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playweft.dev/schemas/game-manifest-v1.json",
  "title": "Playweft Game Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "protocol",
    "client",
    "display",
    "modes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": {
          "$ref": "#/$defs/resourceUrl"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "locales"],
      "properties": {
        "defaultLocale": {
          "$ref": "#/$defs/locale"
        },
        "locales": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/translation"
          }
        },
        "icon": {
          "$ref": "#/$defs/resourceUrl"
        },
        "help": {
          "$ref": "#/$defs/resourceUrl"
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "solo": {
          "type": "object",
          "additionalProperties": false
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "required": ["players", "server"],
          "properties": {
            "players": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              }
            },
            "server": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runtime", "entry", "persistence"],
              "properties": {
                "runtime": {
                  "const": "lua"
                },
                "entry": {
                  "$ref": "#/$defs/resourceUrl"
                },
                "persistence": {
                  "enum": ["durable", "live"]
                }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipboard.readText": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "resourceUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
