{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "dev.playweft.rock-paper-scissors",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Rock Paper Scissors",
  "name_localized": {
    "zh-CN": "石头剪刀布"
  },
  "description": "A quick two-player round.",
  "description_localized": {
    "zh-CN": "快速的双人对局。"
  },
  "categories": ["Quick match"],
  "icons": [
    {
      "src": "./rps.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f5f2fa",
  "theme_color": "#7557c8",
  "orientation": "any",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
